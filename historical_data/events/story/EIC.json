          "id": "orderly_transfer",
          "label_vi": "Bàn giao hồ sơ, kho bạc và bộ máy cho Hoàng gia",
          "label_en": "Transfer records, treasury and administration to the Crown",
          "ai_weight": 4,
          "historical": true,
          "effects": [
